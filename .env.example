# Gateway listening port
PORT=8787

# Upstream OpenAI-compatible server (base includes /v1)
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-upstream-key

# Optional proxy (both uppercase and lowercase names are supported)
# HTTPS_PROXY=http://proxy.example:8443
# HTTP_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1

# Logging
LOG_DIR=logs
LOG_BODIES=true
LOG_HEADERS=true
VERBOSE=false

# (Optional) provider ID to route to. The default openai-compatible uses UPSTREAM_BASE_URL/UPSTREAM_API_KEY as-is.
# PROVIDER_ID=openai-compatible

# Message variable store capacity (most recent N)
MESSAGE_STORE_SIZE=200
